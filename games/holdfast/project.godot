; Engine configuration file.
; The Studio Kit is linked in as addons/gamelab_kit by tools/link_kit.py (not
; committed). The Godot version is pinned in /.godot-version.

config_version=5

[application]

config/name="Holdfast"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gamelab_kit/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
