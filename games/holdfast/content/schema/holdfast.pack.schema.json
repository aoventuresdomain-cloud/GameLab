{
  "$extends": "res://addons/gamelab_kit/schema/pack.v0.schema.json",
  "title": "Holdfast content pack schema (extends GameLab pack format v0)",
  "$defs": {
    "level": {
      "required": [
        "keep_health",
        "keep_radius",
        "spawn_radius",
        "aura",
        "tower",
        "staff",
        "hero"
      ],
      "additionalProperties": false,
      "properties": {
        "keep_health": {
          "type": "integer",
          "minimum": 1
        },
        "keep_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spawn_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "first_wave_delay": {
          "type": "number",
          "minimum": 0
        },
        "aura": {
          "type": "object",
          "required": [
            "radius",
            "dps"
          ],
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dps": {
              "type": "number",
              "minimum": 0
            },
            "cursor_speed": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "tower": {
          "$ref": "#/$defs/tower_placement"
        },
        "staff": {
          "$ref": "#/$defs/staff_placement"
        },
        "hero": {
          "$ref": "#/$defs/hero_placement"
        }
      }
    },
    "wave": {
      "additionalProperties": false
    },
    "spawn": {
      "additionalProperties": false
    },
    "enemy": {
      "required": [
        "damage",
        "gold",
        "radius"
      ],
      "additionalProperties": false,
      "properties": {
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "xp_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "xp_value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tower": {
      "additionalProperties": false
    },
    "staff": {
      "required": [
        "damage",
        "range",
        "cooldown",
        "xp_per_level",
        "damage_per_level"
      ],
      "additionalProperties": false,
      "properties": {
        "damage": {
          "type": "number",
          "minimum": 0
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cooldown": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "xp_per_level": {
          "type": "integer",
          "minimum": 1
        },
        "damage_per_level": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "upgrade_node": {
      "additionalProperties": false
    },
    "effect": {
      "properties": {
        "stat": {
          "enum": [
            "aura_dps",
            "aura_radius",
            "keep_health",
            "gold_multiplier",
            "tower_damage",
            "staff_damage"
          ]
        }
      }
    },
    "tower_placement": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "x-ref": "towers"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "staff_placement": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "x-ref": "staff"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "content": {
      "properties": {
        "hero_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hero_path"
          }
        }
      }
    },
    "hero_placement": {
      "type": "object",
      "required": [
        "path",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "x-ref": "hero_paths"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "hero_path": {
      "type": "object",
      "required": [
        "id",
        "name",
        "move_speed",
        "attack",
        "ability"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "move_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "attack": {
          "$ref": "#/$defs/hero_action"
        },
        "ability": {
          "$ref": "#/$defs/hero_action"
        }
      }
    },
    "hero_action": {
      "type": "object",
      "required": [
        "kind",
        "damage",
        "range",
        "cooldown",
        "speed",
        "radius"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "enum": [
            "projectile"
          ]
        },
        "damage": {
          "type": "number",
          "minimum": 0
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cooldown": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "spread_degrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        }
      }
    }
  }
}
