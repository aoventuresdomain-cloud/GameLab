{
  "$extends": "res://addons/gamelab_kit/schema/pack.v0.schema.json",
  "title": "Holdfast content pack schema (extends GameLab pack format v0)",
  "$defs": {
    "level": {
      "required": [
        "keep_health",
        "keep_radius",
        "spawn_radius",
        "aura",
        "staff",
        "hero",
        "light",
        "posts"
      ],
      "additionalProperties": false,
      "properties": {
        "keep_health": {
          "type": "integer",
          "minimum": 1
        },
        "keep_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spawn_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arena": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "number",
              "minimum": 300
            },
            "height": {
              "type": "number",
              "minimum": 300
            }
          }
        },
        "first_wave_delay": {
          "type": "number",
          "minimum": 0
        },
        "wave_pause": {
          "type": "number",
          "minimum": 0
        },
        "aura": {
          "type": "object",
          "required": [
            "radius",
            "dps"
          ],
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dps": {
              "type": "number",
              "minimum": 0
            },
            "cursor_speed": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "tower": {
          "$ref": "#/$defs/tower_placement"
        },
        "staff": {
          "$ref": "#/$defs/staff_placement"
        },
        "hero": {
          "$ref": "#/$defs/hero_placement"
        },
        "light": {
          "type": "object",
          "required": [
            "radius",
            "bonus"
          ],
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "bonus": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "posts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/post"
          }
        },
        "recruits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/staff_placement"
          }
        },
        "balance_check": {
          "type": "object",
          "required": [
            "seeds",
            "min_won_runs",
            "min_hard_runs"
          ],
          "additionalProperties": false,
          "properties": {
            "seeds": {
              "type": "integer",
              "minimum": 1
            },
            "min_won_runs": {
              "type": "integer",
              "minimum": 0
            },
            "min_hard_runs": {
              "type": "integer",
              "minimum": 0
            },
            "kit_gold": {
              "type": "integer",
              "minimum": 0
            },
            "curve": {
              "type": "object",
              "required": [
                "seeds",
                "min_win_rate",
                "max_win_rate",
                "poor_min_win_rate"
              ],
              "additionalProperties": false,
              "properties": {
                "seeds": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_win_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_win_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "poor_min_win_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tower_site"
          }
        },
        "max_posts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "spawn_arcs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/spawn_arc"
          }
        },
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "tutorial": {
          "type": "boolean"
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "stand": {
          "type": "object",
          "required": [
            "intro",
            "waves"
          ],
          "additionalProperties": false,
          "properties": {
            "intro": {
              "type": "string",
              "minLength": 1
            },
            "waves": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "first_clear_gear": {
          "type": "string",
          "x-ref": "gear_items"
        },
        "reward": {
          "type": "object",
          "required": [
            "stars",
            "gold"
          ],
          "additionalProperties": false,
          "properties": {
            "stars": {
              "type": "integer",
              "minimum": 0
            },
            "gold": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "wave": {
      "additionalProperties": false,
      "properties": {
        "health_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "spawn": {
      "additionalProperties": false
    },
    "enemy": {
      "required": [
        "damage",
        "engage_distance",
        "gold",
        "radius"
      ],
      "additionalProperties": false,
      "properties": {
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engage_distance": {
          "type": "number",
          "minimum": 0
        },
        "xp_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "xp_value": {
          "type": "integer",
          "minimum": 0
        },
        "hit_interval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tier": {
          "enum": [
            "normal",
            "elite",
            "boss"
          ]
        },
        "required_ability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "exposed_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "besieges": {
          "type": "boolean"
        }
      }
    },
    "tower": {
      "additionalProperties": false,
      "required": [
        "health",
        "radius"
      ],
      "properties": {
        "health": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pierce_width": {
          "type": "number",
          "minimum": 0
        },
        "recruit_bonus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "flare_bonus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "splash_radius": {
          "type": "number",
          "minimum": 0
        },
        "unlit_bonus": {
          "type": "number",
          "minimum": 0
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "staff": {
      "required": [
        "damage",
        "range",
        "cooldown",
        "xp_per_level",
        "damage_per_level",
        "health",
        "radius",
        "class",
        "revive_seconds",
        "revive_health",
        "leash",
        "move_speed",
        "retreat_below",
        "rest_heal"
      ],
      "additionalProperties": false,
      "properties": {
        "damage": {
          "type": "number",
          "minimum": 0
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cooldown": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "xp_per_level": {
          "type": "integer",
          "minimum": 1
        },
        "damage_per_level": {
          "type": "number",
          "minimum": 0
        },
        "class": {
          "enum": [
            "warden",
            "lookout",
            "alchemist",
            "engineer"
          ]
        },
        "health": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "revive_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "revive_health": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "leash": {
          "type": "number",
          "minimum": 0
        },
        "move_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retreat_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rest_heal": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "upgrade_node": {
      "additionalProperties": false,
      "required": [
        "branch",
        "tier",
        "at"
      ],
      "properties": {
        "at": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "branch": {
          "type": "string",
          "x-ref": "upgrade_sections"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "upgrade_nodes"
          }
        },
        "tower": {
          "type": "string",
          "x-ref": "towers"
        },
        "hero": {
          "type": "string",
          "x-ref": "hero_paths"
        },
        "currency": {
          "type": "string",
          "enum": [
            "gold",
            "stars"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "slots": {
              "type": "integer",
              "minimum": 0
            },
            "cards": {
              "type": "integer",
              "minimum": 0
            },
            "mage_cards": {
              "type": "integer",
              "minimum": 0
            },
            "squad": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "needs_nodes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "effect": {
      "properties": {
        "stat": {
          "type": "string",
          "pattern": "^(aura_dps|aura_radius|keep_health|gold_multiplier|staff_damage|beam_reach|recruit\\.[a-z_]+|tower\\.[a-z_]+|hero\\.[a-z_]+(\\.[a-z_]+)?)$"
        }
      }
    },
    "tower_placement": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "x-ref": "towers"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "staff_placement": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "x-ref": "staff"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "post": {
          "type": "string"
        }
      }
    },
    "content": {
      "properties": {
        "hero_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hero_path"
          }
        },
        "role_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_effect"
          }
        },
        "upgrade_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/upgrade_section"
          }
        },
        "gear_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gear_rule"
          }
        },
        "gear_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gear_item"
          }
        },
        "blessings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blessing"
          }
        },
        "castle_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/castle_rule"
          }
        },
        "recruit_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recruit_class"
          }
        },
        "recruit_traits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recruit_trait"
          }
        },
        "recruit_skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recruit_skill"
          }
        },
        "recruit_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recruit_names"
          }
        },
        "recruit_rescues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recruit_rescue"
          }
        },
        "recruit_prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recruit_prices"
          }
        }
      }
    },
    "hero_placement": {
      "type": "object",
      "required": [
        "path",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "x-ref": "hero_paths"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "hero_path": {
      "type": "object",
      "required": [
        "id",
        "name",
        "move_speed",
        "attack",
        "ability",
        "health",
        "radius",
        "pickup_radius",
        "knockdown_delays"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "move_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "attack": {
          "$ref": "#/$defs/hero_action"
        },
        "ability": {
          "$ref": "#/$defs/hero_action"
        },
        "health": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pickup_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "knockdown_delays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "blurb": {
          "type": "string",
          "maxLength": 200
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "untouchable_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "hero_action": {
      "type": "object",
      "required": [
        "kind",
        "damage",
        "range",
        "cooldown"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "enum": [
            "projectile",
            "area",
            "arc"
          ]
        },
        "damage": {
          "type": "number",
          "minimum": 0
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cooldown": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "spread_degrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "centre": {
          "enum": [
            "enemy",
            "hero"
          ]
        },
        "unlit_bonus": {
          "type": "number",
          "minimum": 0
        },
        "arc_degrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360
        },
        "dash_distance": {
          "type": "number",
          "minimum": 0
        },
        "refund_on_kill": {
          "type": "boolean"
        },
        "pierce": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "burn_dps": {
          "type": "number",
          "minimum": 0
        },
        "burn_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "zone_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "zone_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pull": {
          "type": "number",
          "minimum": 0
        },
        "dash_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "dash_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "rapid_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "rapid_interval": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 5
        },
        "slow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "slow_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "post": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "role_effect": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "warden",
            "lookout",
            "alchemist",
            "engineer"
          ]
        },
        "effect_radius": {
          "type": "number",
          "minimum": 0
        },
        "taunt_radius": {
          "type": "number",
          "minimum": 0
        },
        "slow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mark_bonus": {
          "type": "number",
          "minimum": 0
        },
        "field_dps": {
          "type": "number",
          "minimum": 0
        },
        "repair_per_second": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tower_site": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "tower": {
          "type": "string",
          "x-ref": "towers"
        }
      }
    },
    "spawn_arc": {
      "type": "object",
      "required": [
        "centre",
        "width"
      ],
      "additionalProperties": false,
      "properties": {
        "centre": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360
        }
      }
    },
    "upgrade_section": {
      "type": "object",
      "required": [
        "id",
        "name",
        "order"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "tab": {
          "type": "string",
          "minLength": 1
        },
        "rim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gear_rule": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slots",
        "elite_levels",
        "boss_level",
        "elite_chance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "elite_levels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "boss_level": {
          "type": "integer",
          "minimum": 1
        },
        "elite_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "slot_info": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "name",
              "identity"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "identity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "gear_item": {
      "type": "object",
      "required": [
        "id",
        "name",
